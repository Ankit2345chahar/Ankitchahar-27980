def readfile():
    try:
        readfielandfolder()
        name = input("which file you want to read")
        p = Path(name)
        if p.exists() and p.is_file():
            with open(p, 'r') as fs:
                data = fs.read()
                print(data)
                print("Readed Successfully")
        else:
            print("the file does not exits")
